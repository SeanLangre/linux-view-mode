#!/bin/bash
# Starts the CouchTube backend, then opens Firefox in kiosk mode on it.
# mpv, firefox and yt-dlp come from the host system.
HERE="$(dirname "$(readlink -f "$0")")"
PORT="${COUCHTUBE_PORT:-7878}"

for tool in mpv firefox yt-dlp; do
    command -v "$tool" >/dev/null || { echo "couchtube: '$tool' is required but not installed" >&2; exit 1; }
done

export COUCHTUBE_FRONTEND="${COUCHTUBE_FRONTEND:-$HERE/usr/share/couchtube/frontend}"
export COUCHTUBE_MPV_CONFIG="${COUCHTUBE_MPV_CONFIG:-$HERE/usr/share/couchtube/config/mpv}"

"$HERE/usr/bin/couchtube" &
backend=$!
trap 'kill "$backend" 2>/dev/null; wait "$backend" 2>/dev/null' EXIT INT TERM

for _ in $(seq 100); do
    curl -fs "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1 && break
    kill -0 "$backend" 2>/dev/null || exit 1
    sleep 0.1
done

firefox --kiosk "http://127.0.0.1:$PORT"
